# Example Environment Variables for SQS Search Segmenter
# Copy this to .env and fill in your actual values
# DO NOT commit .env file to git (it's in .gitignore)

#############################################################################
# AWS Configuration
#############################################################################
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/your-queue-name

#############################################################################
# Neo4j Database
#############################################################################
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

#############################################################################
# Milvus Vector Database
#############################################################################
MILVUS_URI=https://your-milvus-instance.com
MILVUS_TOKEN=your-milvus-token
MILVUS_COLLECTION_NAME=your-collection-name

#############################################################################
# Firebase / Google Cloud Storage
#############################################################################
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com

# Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# For Render: Upload JSON as Secret File, then use:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-credentials.json

#############################################################################
# Gemini API
#############################################################################
GEMINI_API_KEY=your-gemini-api-key

#############################################################################
# Application Settings (Optional)
#############################################################################
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

