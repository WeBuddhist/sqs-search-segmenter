# Production Environment Configuration Template
# 
# IMPORTANT: This file contains only NON-SENSITIVE configuration values.
# Sensitive credentials (passwords, API keys, etc.) are stored in AWS Secrets Manager.
# See README_DEPLOYMENT.md for details on secrets management.
#
# Usage:
#   1. Copy this file to create your .env file (if running locally)
#   2. Update values for your production environment
#   3. For ECS deployment, secrets are automatically injected from AWS Secrets Manager

###############################################################################
# Environment
###############################################################################

ENVIRONMENT=prod

###############################################################################
# AWS Configuration (Non-Sensitive)
###############################################################################

# AWS Region where your services are deployed
AWS_REGION=us-east-1

# Note: AWS credentials are stored in AWS Secrets Manager, not here
# - AWS_ACCESS_KEY_ID (in Secrets Manager)
# - AWS_SECRET_ACCESS_KEY (in Secrets Manager)
# - SQS_QUEUE_URL (in Secrets Manager)

###############################################################################
# Application Settings
###############################################################################

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Python settings for containerized environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

###############################################################################
# Database Configuration (Non-Sensitive)
###############################################################################

# Neo4j username (typically 'neo4j')
NEO4J_USER=neo4j

# Note: Sensitive database credentials are in AWS Secrets Manager:
# - NEO4J_URI (in Secrets Manager)
# - NEO4J_PASSWORD (in Secrets Manager)

###############################################################################
# Vector Database (Non-Sensitive)
###############################################################################

# Note: Milvus credentials are in AWS Secrets Manager:
# - MILVUS_URI (in Secrets Manager)
# - MILVUS_TOKEN (in Secrets Manager)
# - MILVUS_COLLECTION_NAME (in Secrets Manager)

###############################################################################
# Firebase Storage (Non-Sensitive)
###############################################################################

# Note: Firebase credentials are in AWS Secrets Manager:
# - FIREBASE_STORAGE_BUCKET (in Secrets Manager)
# - GOOGLE_APPLICATION_CREDENTIALS JSON (in Secrets Manager)

# For local development, you can specify the path to credentials file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

###############################################################################
# API Keys (Sensitive - Stored in Secrets Manager)
###############################################################################

# Note: API keys are in AWS Secrets Manager:
# - GEMINI_API_KEY (in Secrets Manager)

###############################################################################
# PostgreSQL Configuration (if needed)
###############################################################################

# Note: Only if you're using PostgreSQL for job tracking
# POSTGRES_URL=postgresql://user:password@host:port/database

###############################################################################
# ECS Deployment Notes
###############################################################################
#
# When deployed to ECS Fargate:
# 1. Non-sensitive values (like AWS_REGION, LOG_LEVEL) can be set as 
#    environment variables in task definitions
# 
# 2. Sensitive values are automatically injected from AWS Secrets Manager
#    using the task execution role
#
# 3. The task definition references secrets by ARN, not by value
#
# 4. To update secrets:
#    aws secretsmanager update-secret \
#      --secret-id sqs-search-segmenter/SECRET_NAME \
#      --secret-string "NEW_VALUE" \
#      --region us-east-1
#
# 5. After updating secrets, restart ECS services:
#    aws ecs update-service \
#      --cluster sqs-search-segmenter-cluster \
#      --service sqs-search-segmenter-api \
#      --force-new-deployment \
#      --region us-east-1
#
###############################################################################

###############################################################################
# Local Development Override
###############################################################################
#
# If you're running locally (not on ECS), you can uncomment and fill these:
#
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/queue-name
# NEO4J_URI=bolt://localhost:7687
# NEO4J_PASSWORD=your_neo4j_password
# MILVUS_URI=your_milvus_uri
# MILVUS_TOKEN=your_milvus_token
# MILVUS_COLLECTION_NAME=your_collection_name
# FIREBASE_STORAGE_BUCKET=your-bucket-name
# GEMINI_API_KEY=your_gemini_api_key
#
###############################################################################

